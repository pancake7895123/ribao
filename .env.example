# ============ 必填 ============
# 在 https://platform.deepseek.com/api_keys 创建
DEEPSEEK_API_KEY=sk-your-deepseek-api-key

# ============ 可选 ============
# 官方视觉模型，当前为 deepseek-flash
DEEPSEEK_MODEL=deepseek-flash

# 官方 Chat Completions 端点
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions

# 报表日期。留空则自动使用 REPORT_TIMEZONE 的当天。
# 需要固定为示例日期时，取消下一行注释：
# REPORT_DATE=2026/11/10
REPORT_TIMEZONE=Asia/Shanghai

# 后端监听地址与端口
HOST=127.0.0.1
PORT=5000

# 图片大小与上游超时
MAX_IMAGE_MB=20
UPSTREAM_TIMEOUT_SECONDS=120

# 宽图自动上下裁切：宽度超过 2000 且高度不低于 600 时拆成两张图，
# 重叠比例 0.08（8%）避免裁断表格行。
IMAGE_SPLIT_WIDTH=2000
IMAGE_SPLIT_MIN_HEIGHT=600
IMAGE_SPLIT_OVERLAP=0.08

# 输出 token 上限；复杂表格可调大到 16384。
# 当前请求已关闭思考模式，8192 通常足够。
MAX_OUTPUT_TOKENS=8192

# 设为 1 时，把 DeepSeek 的请求体、原始 response、finish_reason、
# usage 和归一化后的文本打印到启动 app.py 的终端。排查完后可改为 0。
DEBUG_UPSTREAM=1

# 日志级别
LOG_LEVEL=INFO

# 本地调试时设为 1；日常使用保持 0
FLASK_DEBUG=0
